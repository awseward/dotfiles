# nix build out-links. NB: this only keeps git clean — a `path:` flake copies
# whatever is physically in the dir regardless of .gitignore, so never leave a
# `result` symlink in tag-macos/config/nix-darwin or it gets slurped into the flake source.
result
result-*
*.patch
