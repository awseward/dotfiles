#!/usr/bin/env ysh

proc upgrade {
  # This command may not exist on some machines…
  if boolstatus command -v mscp.sh {
    _p 'mscp.sh'
    mscp.sh
  }

  var flake_file = $(realpath "$[ENV.HOME]/.nixpkgs/flake.nix")
  var flake_dir = $(dirname "$flake_file")
  var flake = "path:$[flake_dir]#macos"

  # Update the tracked lockfile as the current user so it stays user-owned.
  # Only activation needs root.
  _p "nix flake update --flake path:$[flake_dir]"
  # This cd is redundant but I'm leaving it here for now.
  cd $flake_dir {
    nix flake update --flake "path:$[flake_dir]"
  }

  _p "sudo darwin-rebuild switch --flake $[flake]"
  sudo darwin-rebuild switch --flake $flake

  _p  'brew-outgrade'
  exec brew-outgrade
}

proc prune (older_than='30d') {
  # Elevate ONLY this call, so it reaches the root-owned darwin system
  # generations (where the disk really accumulates). brew cleanup below must stay
  # user-level, so run the script as yourself -- never `sudo hygiene-daily.ysh
  # prune`, which would run brew as root. Window defaults to 30d; override as
  # e.g. `$f_ prune 7d`.
  _p "sudo nix-collect-garbage --delete-older-than $[older_than]"
      sudo nix-collect-garbage --delete-older-than $[older_than]

  # NB: OLDER_THAN governs only the nix GC above; brew cleanup uses its own
  # defaults (version removal isn't age-based anyway).
  _p  'brew cleanup'
  exec brew cleanup
}

proc help {
  var f_ = $(basename $0)

  redir >&2 {
    write -- """

    === Hygiene Script ===

    This is a script of hygiene tasks to be run regularly. Things like upgrading
    and pruning dependencies, mostly.

    Currently its main motivation is to encapsulate a system that is split between
    homebrew and nix.

    USAGES

      • $f_ upgrade

        Upgrade dependencies.

      • $f_ prune [OLDER_THAN]

        Clean up leftover cruft from dependency tools. OLDER_THAN sets the
        nix-collect-garbage window and defaults to 30d (e.g. $f_ prune 7d).
    """
  }
}

proc _p (...args) { redir >&2 { write -- "; $[join(args, ' ')]"; } }

# ---

if (ARGV === []) { help; exit 1  }

runproc @ARGV
