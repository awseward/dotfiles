OPENSSL_PREFIX="$(brew --prefix openssl@3)"
ICU_PREFIX="$(ls -d /opt/homebrew/opt/icu4c@* | sort -rV | head -1)"
PKG_CONFIG_PATH="${ICU_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}"
POSTGRES_EXTRA_CONFIGURE_OPTIONS="--with-openssl --with-libraries=${OPENSSL_PREFIX}/lib:${ICU_PREFIX}/lib --with-includes=${OPENSSL_PREFIX}/include:${ICU_PREFIX}/include --with-icu"
